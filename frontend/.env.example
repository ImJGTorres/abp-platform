# Plantilla de variables de entorno del frontend.
# Copiar a .env (ignorado por git) y ajustar los valores. No poner secretos aquí:
# todo lo que empieza por VITE_ queda incrustado en el bundle público.

# URL del backend. Vacío = mismo origen (en desarrollo, el proxy de vite.config.js
# redirige /api y /media a http://localhost:8000).
VITE_API_URL=

# Usar datos simulados en lugar del backend (true | false).
VITE_USE_MOCK=false
