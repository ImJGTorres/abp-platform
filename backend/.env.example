# Copia este archivo como .env y completa los valores. No subas el .env al repositorio.

# --- Django ---
# Genera una clave larga y aleatoria: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave
# DEBUG=True solo en tu máquina. En producción debe ser False (activa HTTPS, cookies seguras, HSTS y CSP).
DEBUG=False
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Orígenes de confianza para CSRF (separados por coma) y de conexión extra para el CSP
# (solo si la API y el frontend están en dominios distintos).
# CSRF_TRUSTED_ORIGINS=https://tu-app.onrender.com
# CSP_CONNECT_SRC_EXTRA=
# Cantidad de proxies delante de Django (Render = 1): define qué IP de X-Forwarded-For se usa.
# TRUSTED_PROXY_COUNT=1
# Límites (opcionales): intentos de login fallidos y peticiones por minuto.
# LOGIN_MAX_INTENTOS_PAR=5
# LOGIN_MAX_INTENTOS_CORREO=20
# LOGIN_MAX_INTENTOS_IP=30
# THROTTLE_ANON=120/min
# THROTTLE_USER=1200/min

# --- Base de datos (PostgreSQL / Supabase) ---
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=tu-contrasena
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432

# --- Correo (HU-043) ---
# Local: los correos se imprimen en la consola del servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Producción / staging con SendGrid (django-anymail):
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=
# Remitente: en SendGrid debe ser un remitente o dominio verificado.
DEFAULT_FROM_EMAIL=Plataforma ABP <noreply@ufps.edu.co>
EMAIL_TIMEOUT=10

# Solo si se usa SMTP (EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# URL pública del frontend: los correos la usan para el logo (/media/...) y los enlaces.
FRONTEND_URL=http://localhost:5173
